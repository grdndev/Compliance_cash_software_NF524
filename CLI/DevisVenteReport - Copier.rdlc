    <DataSet Name="CLIDataSet_V_reglement">
      <Query>
        <DataSourceName>CLIConnectionString</DataSourceName>
        <CommandText>SELECT     dbo.T_Reglement.Id_T_Reglement, dbo.T_Reglement.Condition_reglement, dbo.T_Reglement.Moyen_paiement, dbo.T_Reglement.Montant, 
                      dbo.T_Reglement.Reference_avoir_bon, dbo.T_Reglement.Enregistre_le, CONVERT(varchar, dbo.T_Reglement.Echeance_le, 103) AS Echeance_le, 
                      dbo.T_Reglement.Encaisse_le, dbo.T_Reglement.A_Encaisser, dbo.T_Reglement.id_t_commande_vente, 
                      T_MoyenPaiement.Libelle AS Libelle_moyenpaiement, T_ModeReglement.Libelle AS Libelle_modereglement, 
                      dbo.T_CommandeVente.ID_T_Client
FROM         dbo.T_Reglement INNER JOIN
                      T_MoyenPaiement ON dbo.T_Reglement.Moyen_paiement = T_MoyenPaiement.Id_T_MoyenPaiement INNER JOIN
                      T_ModeReglement ON dbo.T_Reglement.Condition_reglement = T_ModeReglement.Id_T_ModeReglement INNER JOIN
                      dbo.T_CommandeVente ON dbo.T_Reglement.id_t_commande_vente = dbo.T_CommandeVente.ID_T_CommandeVente AND 
                      dbo.T_Reglement.id_t_commande_vente = dbo.T_CommandeVente.ID_T_CommandeVente</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Id_T_Reglement">
          <DataField>Id_T_Reglement</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Condition_reglement">
          <DataField>Condition_reglement</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Moyen_paiement">
