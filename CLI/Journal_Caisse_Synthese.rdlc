  <DataSets>
    <DataSet Name="CLIDataSet_V_journal_caisse">
      <Query>
        <DataSourceName>CLIConnectionString</DataSourceName>
        <CommandText>SELECT    *
FROM         dbo.V_journal_caisse
ORDER BY [Num Compte], libelle, Date_encaissement</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Num_Compte">
