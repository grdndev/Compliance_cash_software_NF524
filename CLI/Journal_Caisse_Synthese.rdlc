          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Date_encaissement">
          <DataField>Date_encaissement</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Montant">
