        </Field>
        <Field Name="id_t_commande_vente">
          <DataField>id_t_commande_vente</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="Libelle_moyenpaiement">
          <DataField>Libelle_moyenpaiement</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Libelle_modereglement">
          <DataField>Libelle_modereglement</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
      <Query>
        <DataSourceName>CLIConnectionString</DataSourceName>
        <CommandText>SELECT     dbo.T_Reglement.Id_T_Reglement, dbo.T_Reglement.Condition_reglement, dbo.T_Reglement.Moyen_paiement, dbo.T_Reglement.Montant, 
                      dbo.T_Reglement.Reference_avoir_bon, dbo.T_Reglement.Enregistre_le, dbo.T_Reglement.Echeance_le, dbo.T_Reglement.Encaisse_le, 
                      dbo.T_Reglement.A_Encaisser, dbo.T_Reglement.id_t_commande_vente, T_MoyenPaiement.Libelle AS Libelle_moyenpaiement, 
                      T_ModeReglement.Libelle AS Libelle_modereglement
FROM         dbo.T_Reglement INNER JOIN
                      T_MoyenPaiement ON dbo.T_Reglement.Moyen_paiement = T_MoyenPaiement.Id_T_MoyenPaiement INNER JOIN
                      T_ModeReglement ON dbo.T_Reglement.Condition_reglement = T_ModeReglement.Id_T_ModeReglement</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
